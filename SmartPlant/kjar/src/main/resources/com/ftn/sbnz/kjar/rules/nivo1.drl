package com.ftn.sbnz.kjar.rules;

import com.ftn.model.Biljka;
import com.ftn.model.SenzorskoOcitavanje;
import com.ftn.model.Alarm;
import com.ftn.model.Notifikacija;
import com.ftn.model.IstorijaZalivanja;
import com.ftn.model.NalogZaAkciju;

rule "Prazan rezervoar"
    salience 90
    no-loop true
when
    $ocitavanje : SenzorskoOcitavanje( $biljkaId : biljkaId, $nivo : nivoRezervoara )
    $biljka : Biljka( id == $biljkaId )
    $alarm : Alarm( biljkaId == $biljkaId, prazanRezervoar != true )
    eval( $nivo <= 10 )
then
    modify($alarm) {
        setPrazanRezervoar(true)
    };
    insert(new Notifikacija($biljkaId, "ALARM: Rezervoar prazan! Biljka " + $biljka.getNaziv() + " ne moze biti zalivena.", "ALARM"));
end

rule "Blokada zalivanja zbog sumnjivog senzora"
    salience 80
    no-loop true
when
    $biljka : Biljka( $biljkaId : id )
    $nalog : NalogZaAkciju( biljkaId == $biljkaId, blokiranoZalivanje != true )
    $nowMs : Long()
    accumulate(
        $z : IstorijaZalivanja(
            biljkaId == $biljkaId,
            $tsMs : timestampMs,
            eval( $nowMs - $tsMs <= 7L * 24L * 60L * 60L * 1000L )
        );
        $count : count($z);
        $count > 5
    )
then
    modify($nalog) {
        setBlokiranoZalivanje(true)
    };
    insert(new Notifikacija($biljkaId, "Biljka " + $biljka.getNaziv() + " zalivana " + $count + " puta u 7 dana - proverite senzor vlage!", "ALARM"));
end