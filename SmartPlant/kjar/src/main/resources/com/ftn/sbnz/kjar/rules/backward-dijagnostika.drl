package com.ftn.sbnz.kjar.rules;

import com.ftn.model.Biljka;
import com.ftn.model.SenzorskoOcitavanje;
import com.ftn.model.IstorijaZalivanja;
import com.ftn.model.DijaganostickiUpit;
import com.ftn.model.Notifikacija;
import com.ftn.model.UzrocnaVeza;
import com.ftn.model.TipBiljke;

query uzrokSimptoma( String trazeniUzrok, String polazniSimptom )
    UzrocnaVeza( trazeniUzrok, polazniSimptom; )
    or
    ( UzrocnaVeza( z, polazniSimptom; ) and uzrokSimptoma( trazeniUzrok, z; ) )
end

rule "Inicijalizacija stabla uzrocnosti"
    salience 1000
    no-loop true
when
    not UzrocnaVeza()
then
    insert(new UzrocnaVeza("TRULEZ_KORENA",      "ZUTI_LISTOVI"));
    insert(new UzrocnaVeza("NEDOSTATAK_AZOTA",   "ZUTI_LISTOVI"));
    insert(new UzrocnaVeza("ETIOLACIJA",         "ZUTI_LISTOVI"));
    insert(new UzrocnaVeza("NAPAD_STETOCINE",    "ZUTI_LISTOVI"));
    insert(new UzrocnaVeza("PREKOMERNA_VLAGA",   "TRULEZ_KORENA"));
    insert(new UzrocnaVeza("NISKA_TEMPERATURA",  "TRULEZ_KORENA"));
    insert(new UzrocnaVeza("DUGOTRAJNA_SUSA",    "NEDOSTATAK_AZOTA"));
    insert(new UzrocnaVeza("NEDOVOLJNO_SVETLO",  "ETIOLACIJA"));
    insert(new UzrocnaVeza("VISOKA_TEMP",        "NAPAD_STETOCINE"));
    insert(new UzrocnaVeza("NISKA_VLAGA_VAZDUHA","NAPAD_STETOCINE"));
    insert(new UzrocnaVeza("PREKOMERNA_SVETLOST","SUNCHANICA"));
    insert(new UzrocnaVeza("VISOKA_TEMP",        "SUNCHANICA"));
    insert(new UzrocnaVeza("NISKA_VLAGA_VAZDUHA","PEPELNICA"));
    insert(new UzrocnaVeza("UMERENA_TEMPERATURA","PEPELNICA"));
end

rule "Potvrdi uslov PREKOMERNA_VLAGA"
    salience 900
    no-loop true
when
    $upit : DijaganostickiUpit( $biljkaId : biljkaId, $nowMs : nowMs )
    accumulate(
        $z : IstorijaZalivanja(
            biljkaId == $biljkaId,
            eval( $nowMs - $z.getTimestampMs() <= 3L * 24L * 60L * 60L * 1000L )
        );
        $count : count($z);
        $count >= 3
    )
    not UzrocnaVeza( "PREKOMERNA_VLAGA_OK", "POTVRDJENO"; )
then
    insert(new UzrocnaVeza("PREKOMERNA_VLAGA_OK", "POTVRDJENO"));
    insert(new UzrocnaVeza("PREKOMERNA_VLAGA", "AKTIVAN_" + $biljkaId));
end

rule "Potvrdi uslov NISKA_TEMPERATURA"
    salience 900
    no-loop true
when
    $upit : DijaganostickiUpit( $biljkaId : biljkaId, $nowMs : nowMs )
    $o : SenzorskoOcitavanje(
        biljkaId == $biljkaId,
        temperatura < 17,
        $ts : timestampMs,
        eval( $nowMs - $ts <= 3L * 24L * 60L * 60L * 1000L )
    )
    not UzrocnaVeza( "NISKA_TEMPERATURA_OK", "POTVRDJENO"; )
then
    insert(new UzrocnaVeza("NISKA_TEMPERATURA_OK", "POTVRDJENO"));
    insert(new UzrocnaVeza("NISKA_TEMPERATURA", "AKTIVAN_" + $biljkaId));
end

rule "Potvrdi uslov DUGOTRAJNA_SUSA"
    salience 900
    no-loop true
when
    $upit : DijaganostickiUpit( $biljkaId : biljkaId, $nowMs : nowMs )
    accumulate(
        $z : IstorijaZalivanja(
            biljkaId == $biljkaId,
            eval( $nowMs - $z.getTimestampMs() <= 7L * 24L * 60L * 60L * 1000L )
        );
        $count : count($z);
        $count == 0
    )
    not UzrocnaVeza( "DUGOTRAJNA_SUSA_OK", "POTVRDJENO"; )
then
    insert(new UzrocnaVeza("DUGOTRAJNA_SUSA_OK", "POTVRDJENO"));
    insert(new UzrocnaVeza("DUGOTRAJNA_SUSA", "AKTIVAN_" + $biljkaId));
end

rule "Potvrdi uslov NEDOVOLJNO_SVETLO"
    salience 900
    no-loop true
when
    $upit : DijaganostickiUpit( $biljkaId : biljkaId, $nowMs : nowMs )
    $o : SenzorskoOcitavanje(
        biljkaId == $biljkaId,
        svetlost < 200,
        $ts : timestampMs,
        eval( $nowMs - $ts <= 7L * 24L * 60L * 60L * 1000L )
    )
    not UzrocnaVeza( "NEDOVOLJNO_SVETLO_OK", "POTVRDJENO"; )
then
    insert(new UzrocnaVeza("NEDOVOLJNO_SVETLO_OK", "POTVRDJENO"));
    insert(new UzrocnaVeza("NEDOVOLJNO_SVETLO", "AKTIVAN_" + $biljkaId));
end

rule "Potvrdi uslov PEPELNICA uslovi"
    salience 900
    no-loop true
when
    $upit : DijaganostickiUpit( $biljkaId : biljkaId, $nowMs : nowMs )
    $o : SenzorskoOcitavanje(
        biljkaId == $biljkaId,
        $ts : timestampMs,
        $vlaznostVazduha : vlaznostVazduha,
        $temp : temperatura,
        eval( $nowMs - $ts <= 24L * 60L * 60L * 1000L ),
        eval( $vlaznostVazduha < 40 ),
        eval( $temp >= 15 && $temp <= 28 )
    )
    not UzrocnaVeza( "PEPELNICA_OK", "POTVRDJENO"; )
then
    insert(new UzrocnaVeza("PEPELNICA_OK", "POTVRDJENO"));
    insert(new UzrocnaVeza("NISKA_VLAGA_VAZDUHA", "AKTIVAN_" + $biljkaId));
    insert(new UzrocnaVeza("UMERENA_TEMPERATURA",  "AKTIVAN_" + $biljkaId));
end

rule "Potvrdi uslov CRVENI PAUK uslovi"
    salience 900
    no-loop true
when
    $upit : DijaganostickiUpit( $biljkaId : biljkaId, $nowMs : nowMs )
    $o : SenzorskoOcitavanje(
        biljkaId == $biljkaId,
        temperatura > 25,
        vlaznostVazduha < 35,
        $ts : timestampMs,
        eval( $nowMs - $ts <= 3L * 24L * 60L * 60L * 1000L )
    )
    not UzrocnaVeza( "CRVENI_PAUK_OK", "POTVRDJENO"; )
then
    insert(new UzrocnaVeza("CRVENI_PAUK_OK", "POTVRDJENO"));
    insert(new UzrocnaVeza("VISOKA_TEMP",         "AKTIVAN_" + $biljkaId));
    insert(new UzrocnaVeza("NISKA_VLAGA_VAZDUHA", "AKTIVAN_" + $biljkaId));
end

rule "Dijagnostika - rekurzivni uzrok"
    salience 100
    no-loop true
when
    $upit : DijaganostickiUpit( $biljkaId : biljkaId, $simptom : simptom, $nowMs : nowMs )
    $biljka : Biljka( id == $biljkaId )
    uzrokSimptoma( $uzrok, $simptom; )
    UzrocnaVeza( $uzrok, $aktivan; )
    eval( $aktivan.equals("AKTIVAN_" + $biljkaId) )
then
    insert(new Notifikacija($biljkaId,
        "Rekurzivna dijagnoza za biljku " + $biljka.getNaziv() +
        ": " + $simptom + " -> uzrok: " + $uzrok + ".",
        "ALARM"));
end

rule "Dijagnostika - uzrok nepoznat"
    salience 50
    no-loop true
when
    $upit : DijaganostickiUpit( $biljkaId : biljkaId, $simptom : simptom, $nowMs : nowMs )
    $biljka : Biljka( id == $biljkaId )
    not (
        uzrokSimptoma( $uzrok, $simptom; )
        and
        UzrocnaVeza( $uzrok, $aktivan; )
        and
        eval( $aktivan.equals("AKTIVAN_" + $biljkaId) )
    )
then
    insert(new Notifikacija($biljkaId,
        "Dijagnoza za biljku " + $biljka.getNaziv() +
        ": Uzrok simptoma " + $simptom + " nije mogao biti automatski utvrden. Preporuka: rucni pregled.",
        "UPOZORENJE"));
end