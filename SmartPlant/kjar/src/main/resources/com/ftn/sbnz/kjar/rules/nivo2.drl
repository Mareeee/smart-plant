package com.ftn.sbnz.kjar.rules;

import com.ftn.model.Biljka;
import com.ftn.model.Alarm;
import com.ftn.model.Dijagnoza;
import com.ftn.model.Notifikacija;
import com.ftn.model.IstorijaZalivanja;
import com.ftn.model.SenzorskoOcitavanje;
import com.ftn.model.TipBiljke;

rule "Rizik od pepelnice"
    salience 70
    no-loop true
when
    $biljka : Biljka( $biljkaId : id,
        tipBiljke == TipBiljke.RUZA ||
        tipBiljke == TipBiljke.FIKUS ||
        tipBiljke == TipBiljke.MONSTERA ||
        tipBiljke == TipBiljke.DRACENA )
    $ocitavanje : SenzorskoOcitavanje( biljkaId == $biljkaId, $temp : temperatura, $vlaznostVazduha : vlaznostVazduha )
    $dijagnoza : Dijagnoza( biljkaId == $biljkaId, rizikPepelnice != true )
    eval( $temp >= 15 && $temp <= 28 && $vlaznostVazduha < 40 )
then
    modify($dijagnoza) {
        setRizikPepelnice(true)
    };
    insert(new Notifikacija($biljkaId, "Uslovi pogoduju razvoju pepelnice za biljku " + $biljka.getNaziv() + ". Preporuka: povecati vlaznost vazduha.", "UPOZORENJE"));
end

rule "Rizik od trulezi korena"
    salience 70
    no-loop true
when
    $biljka : Biljka( $biljkaId : id )
    $ocitavanje : SenzorskoOcitavanje( biljkaId == $biljkaId, $temp : temperatura )
    $alarm : Alarm( biljkaId == $biljkaId, visokaVlaga == true )
    $dijagnoza : Dijagnoza( biljkaId == $biljkaId, rizikTrulezi != true )
    $nowMs : Long()
    eval( $temp < 18 )
    accumulate(
        $z : IstorijaZalivanja(
            biljkaId == $biljkaId,
            $tsMs : timestampMs,
            eval( $nowMs - $tsMs <= 48L * 60L * 60L * 1000L )
        );
        $count : count($z);
        $count > 2
    )
then
    modify($dijagnoza) {
        setRizikTrulezi(true)
    };
    insert(new Notifikacija($biljkaId, "Povisen rizik od trulezi korena za biljku " + $biljka.getNaziv() + ". Obustaviti zalivanje i poboljsati drenazu.", "ALARM"));
end

rule "Rizik od crvenog pauka"
    salience 70
    no-loop true
when
    $biljka : Biljka( $biljkaId : id )
    $ocitavanje : SenzorskoOcitavanje( biljkaId == $biljkaId, temperatura > 25, vlaznostVazduha < 35 )
    $dijagnoza : Dijagnoza( biljkaId == $biljkaId, rizikCrvenogPauka != true )
then
    modify($dijagnoza) {
        setRizikCrvenogPauka(true)
    };
    insert(new Notifikacija($biljkaId, "Uslovi pogoduju razvoju crvenog pauka za biljku " + $biljka.getNaziv() + ". Proveriti nalicje listova.", "UPOZORENJE"));
end

rule "Rizik od lisnih vasi"
    salience 70
    no-loop true
when
    $biljka : Biljka( $biljkaId : id,
        tipBiljke == TipBiljke.RUZA ||
        tipBiljke == TipBiljke.ORHIDEJA ||
        tipBiljke == TipBiljke.MONSTERA ||
        tipBiljke == TipBiljke.SPATIFILUM )
    $ocitavanje : SenzorskoOcitavanje( biljkaId == $biljkaId, $temp : temperatura )
    $alarm : Alarm( biljkaId == $biljkaId, niskaSvetlost == true )
    $dijagnoza : Dijagnoza( biljkaId == $biljkaId, rizikLisnihVasi != true )
    eval( $temp >= 18 && $temp <= 24 )
then
    modify($dijagnoza) {
        setRizikLisnihVasi(true)
    };
    insert(new Notifikacija($biljkaId, "Oslabljena biljka " + $biljka.getNaziv() + " je podlozna napadu lisnih vasi. Poboljsati osvetljenost i pregledati biljku.", "UPOZORENJE"));
end

rule "Kriticno stanje biljke"
    salience 60
    no-loop true
when
    $biljka : Biljka( $biljkaId : id )
    $dijagnoza : Dijagnoza( biljkaId == $biljkaId, kriticnoStanje != true,
        (rizikTrulezi == true || rizikPepelnice == true),
        (rizikCrvenogPauka == true || rizikLisnihVasi == true) )
then
    modify($dijagnoza) {
        setKriticnoStanje(true)
    };
    insert(new Notifikacija($biljkaId, "KRITICNO: Biljka " + $biljka.getNaziv() + " je istovremeno ugrozena bolescu i stetocinama! Preporucuje se hitni pregled i tretman.", "ALARM"));
end